                        "rawQuery": true,
                        "rawSql": "SELECT \r\n    f.id_fecha AS time,\r\n    m.nombre_maquina AS metric,\r\n    SUM(f.horas_sin_trabajar) AS value\r\nFROM fact_paros_produccion f\r\nJOIN dim_maquina m ON f.id_maquina = m.id_maquina\r\nGROUP BY f.id_fecha, m.nombre_maquina\r\nORDER BY f.id_fecha ASC;",
