                      "spec": {
                        "dataset": "bi_envasado",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "--Disponibilidad por máquina\r\nSELECT \r\n    m.nombre_maquina AS metric,\r\n    ROUND((SUM(f.horas_trabajadas) / NULLIF(SUM(f.horas_trabajadas + f.horas_sin_trabajar), 0)) * 100, 1) AS value\r\nFROM fact_paros_produccion f\r\nJOIN dim_maquina m ON f.id_maquina = m.id_maquina\r\nGROUP BY m.nombre_maquina;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
